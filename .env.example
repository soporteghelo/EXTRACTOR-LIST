# GEMINI_API_KEY: clave de Google Gemini. SOLO la usa el servidor (api/gemini.ts).
# No le pongas el prefijo VITE_: Vite mete toda variable VITE_* en el JavaScript
# público y la clave quedaría a la vista de cualquiera en la web desplegada.
GEMINI_API_KEY="tu_api_key_de_gemini_aqui"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
